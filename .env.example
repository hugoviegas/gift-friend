# Database
MONGODB_URI=mongodb://localhost:27017/gift-friend
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gift-friend?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-generate-with-openssl-rand-base64-32

# Encryption (for Secret Santa assignments)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=64-character-hex-string-for-aes-256-encryption-key-here

# Email Configuration (SendGrid example)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM_EMAIL=noreply@giftfriend.com
SMTP_FROM_NAME=Gift Friend

# Optional: For development, you can use a test email service
# like Ethereal Email (https://ethereal.email/)
# SMTP_HOST=smtp.ethereal.email
# SMTP_USER=your-ethereal-username
# SMTP_PASSWORD=your-ethereal-password

# Optional: Disable email sending in development
# SMTP_HOST=disabled
